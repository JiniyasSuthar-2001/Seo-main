# =====================================================================
# SEO INTELLIGENCE PLATFORM — PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to backend/.env and replace placeholders with secure secrets.
# =====================================================================

HOST=127.0.0.1
PORT=8020
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8030
API_BASE_URL=http://127.0.0.1:8020
CORS_ORIGINS=http://localhost:8030,http://127.0.0.1:8030,http://localhost:3000

# Security Keys
SECRET_KEY=replace-with-a-secure-random-64-character-secret-key
ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-encryption-key
OAUTH_STATE_SECRET=replace-with-a-secure-random-oauth-state-secret

# Provider OAuth Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
META_APP_ID=your-meta-facebook-app-id
META_APP_SECRET=your-meta-facebook-app-secret
