# =====================================================================
# SEO INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and populate with your environment secrets.
# NEVER commit the real .env file with production secrets.
# =====================================================================

# ---------------------------------------------------------------------
# ENVIRONMENT SELECTION
# Options: development | test | production
# In 'production' mode, strict startup validation fails closed on missing/insecure keys.
# ---------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------
# SERVER HOST & PORT BINDINGS
# ---------------------------------------------------------------------
HOST=127.0.0.1
PORT=8020
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8030
API_BASE_URL=http://127.0.0.1:8020
FRONTEND_BASE_URL=http://127.0.0.1:8030

# ---------------------------------------------------------------------
# CORS ALLOWED ORIGINS (Comma-separated)
# In production, only explicit domains listed here are permitted.
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8030,http://127.0.0.1:8030,http://localhost:3000

# ---------------------------------------------------------------------
# AUTHENTICATION & SECURITY KEYS (REQUIRED IN PRODUCTION)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------
SECRET_KEY=replace-with-a-secure-random-64-character-jwt-signing-secret
ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-fernet-encryption-key
OAUTH_STATE_SECRET=replace-with-a-secure-random-oauth-state-secret

# Development-only user header bypass (MUST remain false in production)
ALLOW_DEV_USER_HEADER=false

# ---------------------------------------------------------------------
# GOOGLE OAUTH 2.0 CREDENTIALS
# Required for Google Search Console, GA4 & GIS Login integrations.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ---------------------------------------------------------------------
# META / FACEBOOK INTEGRATION CREDENTIALS (OPTIONAL)
# ---------------------------------------------------------------------
META_APP_ID=your-meta-facebook-app-id
META_APP_SECRET=your-meta-facebook-app-secret

# ---------------------------------------------------------------------
# PLATFORM AI PROVIDER CREDENTIALS
# Options: groq | gemini | openai | anthropic | ollama
# ---------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Additional AI Provider Keys (Optional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=models/gemini-flash-latest
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
