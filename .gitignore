# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Database Files & Backups (Prevent packaging local data snapshots)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3
seo.db
backend/seo.db

# Environment Files & Secrets (Strictly Excluded)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
*.pem
*.key
*.crt
*.pfx
*.p12

# Crawl Artifacts Data Storage
data/
backend/data/
backend/data/websites/*
!backend/data/websites/.gitkeep

# Temporary & Scratch Files
scratch/
backend/scratch/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
