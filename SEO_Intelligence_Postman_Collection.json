			"name": "Projects",
			"item": [
				{
					"name": "Get All Projects",
					"request": {
						"method": "GET",
						"url": "http://127.0.0.1:8000/api/projects"
					}
				},
				{
					"name": "Create Project",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"UIS Digital\",\n  \"domain\": \"https://uisdigital.com/\"\n}"
						},
						"url": "http://127.0.0.1:8000/api/projects"
					}
				}
