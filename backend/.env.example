# SEO Intelligence Platform - Environment Configuration Example

HOST=127.0.0.1
PORT=8020
DATABASE_URL=sqlite:///./seo.db
SECRET_KEY=your-secret-key-here
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
FRONTEND_PORT=8030
FRONTEND_BASE_URL=http://127.0.0.1:8030
API_BASE_URL=http://127.0.0.1:8020
CORS_ORIGINS=http://localhost:8030,http://127.0.0.1:8030

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Platform AI Credentials (Groq is default platform provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# Customer AI Integrations are added via UI (encrypted per-user in database)
# Optional fallback env placeholders:
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
